# Copie para .env e ajuste se precisar. Todos os valores têm default no docker-compose.yml.
POSTGRES_DB=os_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Segredo HS256 do JWT: o mesmo da Lambda de autenticação (mínimo de 32 caracteres)
SECURITY_JWT_SECRET=jwt-local-secret-123456789012345678901234567890
SECURITY_JWT_EXPIRATION=7200000
