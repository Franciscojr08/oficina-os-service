{
  "info": {
    "name": "Oficina - OS Service (Fase 4)",
    "description": "Todos os endpoints do OS Service, em sequência: cadastros, fluxo da OS até o pedido de orçamento, cancelamento, consultas e erros. Cada request tem asserções; os ids criados passam de um request para o outro por variáveis da collection.\n\nSelecione o environment 'OS Service - Local' e rode a collection inteira (Runner ou newman). Os dados (CPF, placa, nomes) são gerados a cada execução, então ela pode rodar várias vezes no mesmo banco.\n\nTeste automatizado: ColecaoPostmanCobreEndpointsTest falha se algum endpoint da API ficar sem request aqui.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "sufixo",
      "value": ""
    },
    {
      "key": "cpf",
      "value": ""
    },
    {
      "key": "placa",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "veiculoId",
      "value": ""
    },
    {
      "key": "servicoId",
      "value": "30"
    },
    {
      "key": "itemId",
      "value": "20"
    },
    {
      "key": "osId",
      "value": ""
    },
    {
      "key": "codigoOs",
      "value": ""
    },
    {
      "key": "osCanceladaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Saúde",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Login do operador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminSenha}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"token emitido\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login com senha errada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"senha-errada\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"recusado\", () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rota protegida sem token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ordens",
            "body": {
              "mode": "raw",
              "raw": "[\n  \"pm.test(\\\"recusado sem token\\\", () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));\"\n]"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": []
        }
      ]
