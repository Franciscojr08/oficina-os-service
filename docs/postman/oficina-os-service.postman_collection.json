            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const L = () => String.fromCharCode(65 + Math.floor(Math.random() * 26));",
                  "const D = () => Math.floor(Math.random() * 10);",
                  "pm.collectionVariables.set(\"placa\", L() + L() + L() + D() + L() + D() + D());"
