    {
      "name": "3. Clientes",
      "item": [
        {
          "name": "Cadastrar cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mariana Oliveira Silva\",\n  \"cpfCnpj\": \"{{cpf}}\",\n  \"telefone\": \"11999990000\",\n  \"email\": \"mariana@example.com\",\n  \"cep\": \"01310100\",\n  \"logradouro\": \"Av. Paulista, 1000\",\n  \"bairro\": \"Bela Vista\",\n  \"cidade\": \"São Paulo\",\n  \"uf\": \"SP\",\n  \"data_nascimento\": \"1990-05-10\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Array.from({length: 9}, () => Math.floor(Math.random() * 10));",
                  "const dv = (base) => { const s = base.reduce((acc, d, i) => acc + d * (base.length + 1 - i), 0); const r = (s * 10) % 11; return r === 10 ? 0 : r; };",
                  "n.push(dv(n)); n.push(dv(n));",
                  "pm.collectionVariables.set(\"cpf\", n.join(\"\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"clienteId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar cliente com CPF inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mariana Oliveira Silva\",\n  \"cpfCnpj\": \"12345678900\",\n  \"telefone\": \"11999990000\",\n  \"email\": \"mariana@example.com\",\n  \"cep\": \"01310100\",\n  \"logradouro\": \"Av. Paulista, 1000\",\n  \"bairro\": \"Bela Vista\",\n  \"cidade\": \"São Paulo\",\n  \"uf\": \"SP\",\n  \"data_nascimento\": \"1990-05-10\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"erro em problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
                  "pm.test(\"mensagem explica o erro\", () => pm.expect(pm.response.json().detail).to.include(\"CPF inválido\"));"
                ]
              }
            }
          ]
        },
